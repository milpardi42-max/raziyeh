{
  "name": "rosie-atelier",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/stackblitz/dev.mjs",
    "prebuild": "node scripts/preserve-data.mjs --snapshot",
    "build": "next build",
    "postbuild": "node scripts/sync-standalone.mjs && node scripts/preserve-data.mjs --restore",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "dev:stackblitz": "node scripts/stackblitz/dev.mjs --force",
    "diagnose:stackblitz": "node scripts/stackblitz/diagnose.mjs",
    "clean:next": "node scripts/stackblitz/clean.mjs",
    "smoke:stackblitz": "node scripts/stackblitz/smoke.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "next": "15.5.25",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "stackblitz": {
    "startCommand": "npm run dev",
    "env": {
      "ROSIE_STACKBLITZ": "1"
    }
  }
}
