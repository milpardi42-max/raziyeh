# Rosie Atelier — environment variables (copy to .env.local for development or production)

# ── Admin panel (REQUIRED in production) ────────────────────────────────
# Without these two, /api/auth/login returns 401 "admin_not_configured" in production.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# ── Owner account (راضیه خیری‌پور) ──────────────────────────────────────
# The email of the site owner. A logged-in user whose email matches this value
# gains owner-level access to /[locale]/owner/* management pages
# (portfolio & academy content management).
OWNER_EMAIL=

# HMAC key for the session cookie. Any long random string, e.g. `openssl rand -hex 32`.
# If unset, ADMIN_PASSWORD is used as the signing key — set a dedicated one.
AUTH_SECRET=

# ── Content persistence ────────────────────────────────────────────────
# Option 1: Upstash Redis for shared or persistent deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# With neither, content falls back to ./data/content.json.

# ── First-party media storage (images and videos) ───────────────────────
# New user/admin image and academy-video uploads are returned as same-origin
# /api/media/<id> URLs. They are never rendered from Cloudinary/Vercel URLs.
# Configure the S3-compatible backend below for persistent production storage.
# For a self-hosted server, local files live under data/objects/public/media;
# mount that directory on a persistent disk/volume before enabling uploads.
# Legacy CLOUDINARY_* and BLOB_READ_WRITE_TOKEN settings are not used for new media uploads.

# ── Canonical site URL (used by sitemap.xml, robots.txt and OG metadata) ─
# Set this to your public URL WITHOUT a trailing slash.
NEXT_PUBLIC_SITE_URL=
# Optional footer social profile URLs (replace the platform homepage links)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ────────────────────────────────────────────────────────────────────────
# Marketplace: private master files, licensing, payments, royalties
# ────────────────────────────────────────────────────────────────────────
#
# Nothing below is required to *browse* the marketplace. Each block only turns on
# one integration; without it the platform falls back to a working local/dev mode
# (documented in AUDIT.md).

# ── Private object storage (masters are NEVER served from public/) ──────
# Leave unset for the local backend (<cwd>/data/objects, dev only).
# Any S3-compatible bucket works (AWS S3, R2, Wasabi, Arvan, Liara…).
# This same private bucket backend also stores new public website media under
# public/media/; browsers still fetch it from your own site's /api/media URL.
MARKETPLACE_S3_ENDPOINT=
MARKETPLACE_S3_REGION=
MARKETPLACE_S3_BUCKET=
MARKETPLACE_S3_ACCESS_KEY_ID=
MARKETPLACE_S3_SECRET_ACCESS_KEY=
# Optional: force path-style URLs (MinIO, some Iranian providers)
MARKETPLACE_S3_FORCE_PATH_STYLE=0
MARKETPLACE_S3_PUBLIC_BASE_URL=

# ── Upload limits ────────────────────────────────────────────────────────
MARKETPLACE_MAX_MASTER_MB=2048
MARKETPLACE_MULTIPART_THRESHOLD_MB=200
MARKETPLACE_PART_SIZE_MB=8

# ── Money: VAT, revenue split, payout floor ─────────────────────────────
MARKETPLACE_VAT_PCT=9
MARKETPLACE_ARTIST_SHARE_PCT=40
MARKETPLACE_AFFILIATE_PCT=10
MARKETPLACE_AFFILIATE_DISCOUNT_PCT=10
MARKETPLACE_MIN_PAYOUT_TOMAN=500000
MARKETPLACE_MIN_PAYOUT_USD=25

# ── Links & tokens ──────────────────────────────────────────────────────
# Lifetime of the signed download URL handed to the browser (seconds).
MARKETPLACE_DOWNLOAD_TTL_S=900
# Lifetime of the delivery link sent by e-mail (seconds, default 7 days).
MARKETPLACE_EMAIL_LINK_TTL_S=604800

# ── ZarinPal (Iranian gateway) ──────────────────────────────────────────
# With a merchant id the live v4 REST API is used.
# WITHOUT it the built-in sandbox gateway takes over: purchases are simulated but
# every downstream step (order → licence → certificate → royalty → e-mail) is real.
ZARINPAL_MERCHANT_ID=
ZARINPAL_BASE_URL=https://payment.zarinpal.com/pg

# ── Stripe (international cards) ────────────────────────────────────────
# Without a key, checkout falls back to the same sandbox gateway in USD.
STRIPE_SECRET_KEY=

# ── Virus scanning (ClamAV daemon) ──────────────────────────────────────
# Optional. Without it the built-in heuristic scanner still blocks EICAR,
# executables, macro/webshell patterns and decompression bombs.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Transactional e-mail ────────────────────────────────────────────────
# Order: Resend → SMTP → outbox only (messages are always visible in the admin panel)
RESEND_API_KEY=
MARKETPLACE_EMAIL_FROM="Rosie Atelier <no-reply@rosie-atelier.ir>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# Where review/sale notifications go when an artist has no account address.
MARKETPLACE_ADMIN_EMAIL=
MARKETPLACE_ARTIST_NOTIFY_EMAIL=
# Set to 0 to disable artist sale notifications entirely.
MARKETPLACE_NOTIFY_ARTISTS=1
