# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# build output (next.config.ts sets `distDir: "dist/.next"`)
/.runtime-data/
/dist/
/public/images/uploads/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
/data/*.json

# marketplace runtime data: private master files, staged chunks and derivatives.
# These are buyer/artist assets — never commit them.
/data/objects/
/data/private/

# marketplace object storage (local backend): private masters, staged chunks and
# derived previews live under data/objects — buyer/artist content, never committed
/data/objects/

# local agent/tooling artifacts & logs (never commit these)
/dev.log
/*.log
.Milo/
.bob/
.bruno/

dist.zip
downloads/*.zip
